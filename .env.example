# Copy to .env.local for local development. In production, set these in Netlify
# (Site configuration > Environment variables), then trigger a new deploy: values are inlined at build time.

# EmailJS (contact form). Get them from the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public site address, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://careliftmedicalequipment.com
