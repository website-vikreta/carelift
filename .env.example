# Template only: never commit real values. Copy to .env.local for local development.
# Production values live in Netlify (Site configuration > Environment variables); cloud sessions use the
# environment's own variables. Values are inlined at build time, so rebuild after changing them.

# EmailJS (contact form). From the EmailJS dashboard: Email Services (service ID), Email Templates (template ID),
# Account > General (public key).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public site address, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://careliftmedicalequipment.com
