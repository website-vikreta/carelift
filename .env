# Site settings, read at build time (npm run dev / npm run build).
# These EmailJS values are NOT secrets: EmailJS is called from the browser, so they are visible in the page by design.
# Fill them in from the EmailJS dashboard, then rebuild (npm run build) and redeploy the out/ folder.
# Values set in Netlify (Site configuration > Environment variables) override these when Netlify runs the build.

# EmailJS > Email Services > your service > Service ID (looks like service_xxxxxxx)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# EmailJS > Email Templates > "Contact Us" > Settings > Template ID (looks like template_xxxxxxx)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# EmailJS > Account > General > Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Public site address, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://careliftmedicalequipment.com
